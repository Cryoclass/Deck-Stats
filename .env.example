# ─── Postgres local (docker-compose) ───
DATABASE_URL=postgres://ygo:ygo@localhost:5433/ygo
PORT=8787

# ─── Auth (itération 8) ───
# Codes d'invitation acceptés à l'inscription, séparés par des virgules.
# Liste vide = inscriptions fermées. Révoquer un code = l'enlever + redémarrer.
INVITE_CODES=change-me
# Origine du front autorisée par CORS (cookies de session).
APP_ORIGIN=http://localhost:5173
# COOKIE_SECURE=1   # forcer le flag Secure hors NODE_ENV=production (ex. reverse proxy TLS)

# ─── OAuth Discord (Lot D) — optionnel : bouton masqué si non configuré ───
# App à créer sur https://discord.com/developers/applications → OAuth2 :
# ajouter la redirection http://localhost:5173/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/discord/callback

