# Modèle versionné, SANS secret. Copier en .env.prod (jamais versionné) :
#   cp .env.prod.example .env.prod && chmod 600 .env.prod

# Mot de passe Postgres du conteneur (généré, long : openssl rand -base64 24)
POSTGRES_PASSWORD=

# Codes d'invitation (liste séparée par des virgules). Prendre des codes non
# devinables en production : duel-x7Kq2m, pas duel-2026.
INVITE_CODES=

# Origine publique de l'app (CORS + cookies)
APP_ORIGIN=https://analysis.scratchrecode.com

# OAuth Discord — ajouter AUSSI cette redirection dans le portail développeur :
# https://analysis.scratchrecode.com/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://analysis.scratchrecode.com/api/auth/discord/callback
