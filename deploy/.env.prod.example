# Modèle versionné, SANS secret. Copier en .env.prod (jamais versionné) :
#   cp .env.prod.example .env.prod && chmod 600 .env.prod

# Mot de passe Postgres du conteneur (généré, long : openssl rand -base64 24)
POSTGRES_PASSWORD=

# Codes d'invitation (liste séparée par des virgules). Prendre des codes non
# devinables en production : duel-x7Kq2m, pas duel-2026.
INVITE_CODES=

# Origine publique de l'app (CORS + cookies)
APP_ORIGIN=https://analysis.scratchrecode.com

# OAuth Discord — ajouter AUSSI cette redirection dans le portail développeur :
# https://analysis.scratchrecode.com/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://analysis.scratchrecode.com/api/auth/discord/callback

# ─── Back-office (docs/backoffice.md) — bo.scratchrecode.com ───
# Valeurs SANS guillemets : deploy.sh lit ce fichier tel quel (env_prod_value), Compose aussi.
# Mot de passe du rôle PostgreSQL restreint testhand_backoffice (généré : openssl rand -hex 24 —
# hexadécimal : aucun « @ », qui est le seul caractère interdit dans l'URL de connexion du site).
# deploy.sh le pose sur le rôle après la séquence de migration ; le service admin s'y connecte.
BACKOFFICE_DB_PASSWORD=
# Clé de chiffrement des secrets TOTP, 32 octets en base64 (openssl rand -base64 32).
# La perdre = ré-enrôler chaque admin ; la changer aussi.
BACKOFFICE_TOTP_KEY=
# Hôte public du back-office (bloc Caddy) ; sert au nom d'émetteur du QR TOTP.
BACKOFFICE_HOST=bo.scratchrecode.com
