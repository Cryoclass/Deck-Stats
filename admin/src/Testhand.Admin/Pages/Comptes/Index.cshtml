@page "/comptes"
@model Testhand.Admin.Pages.Comptes.IndexModel
@{
    ViewData["Title"] = "Comptes";
    ViewData["Nav"] = "comptes";
    var p = Model.Result;
    string SortUrl(string key)
    {
        var desc = Model.Sort == key && !Model.Desc;
        return $"/comptes?q={Uri.EscapeDataString(Model.Q)}&tri={key}&sens={(desc ? "desc" : "asc")}";
    }
    string SortMark(string key) => Model.Sort == key ? (Model.Desc ? " ↓" : " ↑") : "";
    string SortClass(string key) => Model.Sort == key ? "sorted" : "";
}
<h1 class="title">Comptes</h1>
<p class="meta">@Fmt.Num(p.Total) compte(s)@(Model.Q.Length > 0 ? $" pour « {Model.Q} »" : "") · page @p.Page / @p.PageCount · « Dernière session » = ouverture de la session encore active la plus récente ; la base ne conserve ni les sessions fermées ni une date de dernière activité.</p>
<form method="get" class="toolbar" role="search">
    <input type="hidden" name="tri" value="@Model.Sort" />
    <input type="hidden" name="sens" value="@(Model.Desc ? "desc" : "asc")" />
    <label for="q" class="field-label">Recherche</label>
    <input id="q" name="q" type="search" value="@Model.Q" placeholder="email ou nom" maxlength="100" />
    <button type="submit" class="btn">Chercher</button>
    @if (Model.Q.Length > 0)
    {
        <a class="btn" href="/comptes">Effacer</a>
    }
</form>
<div class="table-wrap">
<table class="grid">
    <thead>
        <tr>
            <th class="@SortClass("email")"><a href="@SortUrl("email")">@("Email" + SortMark("email"))</a></th>
            <th class="@SortClass("nom")"><a href="@SortUrl("nom")">@("Nom" + SortMark("nom"))</a></th>
            <th class="@SortClass("creation")"><a href="@SortUrl("creation")">@("Création" + SortMark("creation"))</a></th>
            <th class="@SortClass("session")"><a href="@SortUrl("session")">@("Dernière session active" + SortMark("session"))</a></th>
            <th class="num @SortClass("decks")"><a href="@SortUrl("decks")">@("Decks" + SortMark("decks"))</a></th>
            <th>Connexion</th>
            <th class="@SortClass("role")"><a href="@SortUrl("role")">@("Rôle" + SortMark("role"))</a></th>
        </tr>
    </thead>
    <tbody>
    @if (p.Rows.Count == 0)
    {
        <tr><td colspan="7" class="empty">Aucun compte.</td></tr>
    }
    @foreach (var r in p.Rows)
    {
        <tr>
            <td><a href="/comptes/@r.Id" title="@r.Id">@r.Email</a></td>
            <td>@r.DisplayName</td>
            <td class="date">@Fmt.Date(r.CreatedAt)</td>
            <td class="date">@Fmt.Date(r.LastSessionAt)</td>
            <td class="num">@Fmt.Num(r.DeckCount)</td>
            <td>@(string.Join(", ", new[] { r.HasPassword ? "mot de passe" : null, r.Providers }.Where(x => !string.IsNullOrEmpty(x))) is { Length: > 0 } c ? c : "—")</td>
            <td>@if (r.Role == "admin") { <span class="tag ok">admin</span> } else { <span class="tag">user</span> }</td>
        </tr>
    }
    </tbody>
</table>
</div>
<nav class="pager" aria-label="Pagination">
    @if (p.Page > 1) { <a href="/comptes?q=@Uri.EscapeDataString(Model.Q)&tri=@Model.Sort&sens=@(Model.Desc ? "desc" : "asc")&p=@(p.Page - 1)">← Précédent</a> } else { <span class="disabled">← Précédent</span> }
    <span>page @p.Page / @p.PageCount</span>
    @if (p.Page < p.PageCount) { <a href="/comptes?q=@Uri.EscapeDataString(Model.Q)&tri=@Model.Sort&sens=@(Model.Desc ? "desc" : "asc")&p=@(p.Page + 1)">Suivant →</a> } else { <span class="disabled">Suivant →</span> }
</nav>
