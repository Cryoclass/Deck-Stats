@page "/journal"
@model Testhand.Admin.Pages.Journal.IndexModel
@{
    ViewData["Title"] = "Journal";
    ViewData["Nav"] = "journal";
    var p = Model.Result;
    string PageUrl(int n) => $"/journal?action={Uri.EscapeDataString(Model.Action)}&acteur={Uri.EscapeDataString(Model.Acteur)}&cible={Uri.EscapeDataString(Model.Cible)}&du={Model.Du}&au={Model.Au}&p={n}";
}
<h1 class="title">Journal</h1>
<p class="meta">@Fmt.Num(p.Total) ligne(s) · page @p.Page / @p.PageCount · en ajout seul : rien ne s'y modifie ni ne s'y efface, la consultation elle-même y est inscrite.</p>
@if (Model.FilterError is not null)
{
    <div class="banner warn">@Model.FilterError</div>
}
<form method="get" class="toolbar" role="search">
    <label class="field-label" for="action">Action</label>
    <select id="action" name="action">
        <option value="">toutes</option>
        @foreach (var a in Model.Actions)
        {
            <option value="@a" selected="@(a == Model.Action)">@a</option>
        }
    </select>
    <label class="field-label" for="acteur">Acteur</label>
    <input id="acteur" name="acteur" type="search" value="@Model.Acteur" placeholder="email" maxlength="100" />
    <label class="field-label" for="cible">Cible</label>
    <input id="cible" name="cible" type="search" value="@Model.Cible" placeholder="identifiant de compte" maxlength="36" class="mono" />
    <label class="field-label" for="du">Du</label>
    <input id="du" name="du" type="date" value="@Model.Du" />
    <label class="field-label" for="au">Au</label>
    <input id="au" name="au" type="date" value="@Model.Au" />
    <button type="submit" class="btn">Filtrer</button>
    <a class="btn" href="/journal">Effacer</a>
</form>
<div class="table-wrap">
<table class="grid">
    <thead><tr><th class="num">N°</th><th>Date</th><th>Acteur</th><th>Action</th><th>Source</th><th>Cible</th><th>Détail</th></tr></thead>
    <tbody>
    @if (p.Rows.Count == 0)
    {
        <tr><td colspan="7" class="empty">Aucune ligne.</td></tr>
    }
    @foreach (var r in p.Rows)
    {
        var cls = r.Action.EndsWith(".failure") || r.Action == "login.throttled" || r.Action == "session.revoked" ? "neg" : r.Action.StartsWith("role.") ? "warn" : r.Action.EndsWith(".success") || r.Action == "totp.enrol" ? "ok" : "";
        <tr>
            <td class="num">@r.Id</td>
            <td class="date">@Fmt.Date(r.At)</td>
            <td title="@r.ActorUserId">@Fmt.Text(r.ActorEmail)</td>
            <td><span class="tag @cls">@r.Action</span></td>
            <td>@r.Source</td>
            <td class="mono">@if (r.TargetUserId is { } t) { <a href="/comptes/@t" title="@t">@Fmt.ShortId(t)</a> } else { <text>—</text> }</td>
            <td class="detail mono">@r.Detail</td>
        </tr>
    }
    </tbody>
</table>
</div>
<nav class="pager" aria-label="Pagination">
    @if (p.Page > 1) { <a href="@PageUrl(p.Page - 1)">← Précédent</a> } else { <span class="disabled">← Précédent</span> }
    <span>page @p.Page / @p.PageCount</span>
    @if (p.Page < p.PageCount) { <a href="@PageUrl(p.Page + 1)">Suivant →</a> } else { <span class="disabled">Suivant →</span> }
</nav>
